{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/your-org/awesome-hiring-companies/schemas/company.schema.json",
  "title": "Awesome Hiring Companies",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "slug",
      "domain",
      "careers_url",
      "category",
      "ats",
      "tags",
      "sources"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "domain": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]+\\.[a-z]{2,}$"
      },
      "careers_url": {
        "type": "string",
        "format": "uri"
      },
      "category": {
        "type": "string",
        "enum": [
          "ai-and-data",
          "developer-infrastructure",
          "fintech",
          "consumer-and-marketplace",
          "open-source-and-platform"
        ]
      },
      "ats": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}

